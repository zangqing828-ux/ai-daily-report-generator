# Database
DATABASE_URL="postgresql://user:YOUR_SECURE_PASSWORD@localhost:5432/ai_daily_report?schema=public"
# 或者使用环境变量单独配置
# DB_USER="your_user"
# DB_PASSWORD="your_secure_password"
# DB_NAME="ai_daily_report"
# DB_HOST="localhost"
# DB_PORT="5432"

# Server
PORT=3001
NODE_ENV=development

# Redis
REDIS_URL="redis://localhost:6379"

# CORS
FRONTEND_URL="http://localhost:5173"

# 豆包 API (未来集成)
DOUBAO_API_KEY=""
DOUBAO_API_URL=""

# WebRTC
ICE_SERVERS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
