// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户模型
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash String? // 存储加密后的密码
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  projects   Project[]
  reports    DailyReport[]
  profile    UserProfile?
  conversationSummaries ConversationSummary[]
}

// 项目模型
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  reports     DailyReport[]
  context     ProjectContext?
  conversationSummaries ConversationSummary[]

  @@unique([userId, name])
  @@index([userId])
}

// 日报模型
model DailyReport {
  id           String   @id @default(uuid())
  date         String   // 格式: YYYY-MM-DD
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // 日报内容
  todayWork    Json     // 存储分类后的工作内容 {开发: [...], 会议: [...], ...}
  tomorrowPlan String[] // 存储优先级排序的计划
  summary      String   // AI生成的摘要
  conversation Json?    // 可选：存储完整对话记录

  // 元数据
  duration     String?  // 通话时长 "3:45"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, projectId, date])
  @@index([userId, date])
  @@index([projectId, date])
}

// ============================================
// Phase 2: 长期记忆系统 - 新增模型
// ============================================

// 用户档案 - 存储用户偏好、工作习惯
model UserProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // 工作习惯偏好
  preferences Json   // 存储 ReportingStyle, PreferredTime, InteractionStyle, ContentPreferences
  
  // 学习数据
  learningData Json? // 存储 CommonPhrases, WorkPatterns, CommunicationStyle
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

// 项目上下文 - 存储项目历史、关键成果、进行中的任务
model ProjectContext {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // 项目元信息
  metadata Json      // description, techStack, teamSize, startDate, targetDate
  
  // 关键成果（累积）
  keyAccomplishments Json[] // 数组形式存储，便于追加
  
  // 进行中的任务（动态更新）
  ongoingTasks Json[]
  
  // 已知阻碍（累积）
  blockers Json[]
  
  // 相关干系人
  stakeholders Json[]
  
  // 项目健康度（AI 评估）
  healthMetrics Json?
  
  lastUpdatedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  
  @@index([projectId])
  @@index([lastUpdatedAt])
}

// 对话历史摘要 - 存储每次对话的摘要和洞察
model ConversationSummary {
  id        String   @id @default(uuid())
  
  // 关联
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  // 基本信息
  sessionId String   @unique
  date      DateTime
  duration  Int      // 通话时长（秒）
  
  // AI 生成的摘要
  summary   Json     // overview, keyTopics, accomplishments, blockers, nextSteps, insights
  
  // 行动项（可追踪）
  actionItems Json[]
  
  // 用户反馈
  userFeedback Json?
  
  // 原始对话（保留7天，可选）
  rawTranscript Json?
  transcriptExpiresAt DateTime?
  
  createdAt DateTime @default(now())
  
  @@unique([userId, projectId, sessionId])
  @@index([userId, date])
  @@index([projectId, date])
  @@index([sessionId])
  @@index([transcriptExpiresAt])
}
